// たすきば Knowledge Relay - Prisma Schema
// 設計書: docs/design/DATA_MODEL.md / docs/design/SUGGESTION_ENGINE.md

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // PR #4 (T-03 Phase 2): pgvector の vector 型を Prisma が認識できないため、
  // Unsupported("vector(1024)") として宣言。Prisma Client では `unknown` 型として扱われ、
  // 直接 read/write するには $queryRaw を使う。
  // 詳細: https://www.prisma.io/docs/orm/prisma-schema/data-model/unsupported-database-features
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // PR #4 (T-03 Phase 2): pgvector 拡張を Prisma に明示。
  // migration では `CREATE EXTENSION IF NOT EXISTS vector;` を実行する。
  //
  // 注: Prisma 7 では url / directUrl は schema.prisma に書けない (P1012 で禁止)。
  //   代わりに prisma.config.ts の `datasource.url` で指定する。
  //   prisma.config.ts は `process.env['DIRECT_URL'] || process.env['DATABASE_URL']`
  //   の優先順で接続先を決定 (migrate 系は DIRECT_URL を使う設計)。
  //   PrismaClient ランタイムは process.env.DATABASE_URL を自動利用する。
  extensions = [vector]
}

// ============================================================
// Tenants (PR #2 / T-03 提案エンジン v2)
// ============================================================
//
// マルチテナント基盤。すべての業務エンティティの所属を一元管理する。
// v1 (2026-06-01) は default-tenant という単一テナントのみで稼働し、
// v1.x で UI を介したテナント追加を可能にする。
//
// 課金モデル (per-API-call、3 プラン構成、ADR-0019 / 2026-05-24 改定版):
//   - Beginner: 月間 **50 回**上限・最大 5 席・無料・Claude Haiku
//     (上限カウントは `project-upsert` のみ。資産・チャット等の無料 featureUnit はカウント外)
//   - Expert:   無制限従量課金 (**¥10/call**、ADR-0019 改定: ¥5 → ¥10)・Claude Haiku
//   - Pro:      無制限従量課金 (¥15/call、据置)・Claude Sonnet
//
// 課金対象 call (= `BILLABLE_FEATURE_UNITS` / src/config/billing-feature-units.ts):
//   - `project-upsert`: プロジェクト作成/更新 (LLM auto-tag + embedding 集約)
//   - `suggestion-explanation`: なぜ機能 (Pro 限定の LLM)
//   - `auto-tag-extract`: スタンドアロン auto-tag (予約)
// それ以外の featureUnit (knowledge-embedding / chat-semantic-search / *-backfill 等) は
// 全プラン無料。ApiCallLog には costJpy=0 で記録、counter / Stripe queue は不変。
// 詳細: docs/adr/0019-billable-feature-units-and-free-tier-expansion.md
//
// 月初リセット: Vercel Cron が `lastResetAt < 当月初` のテナントの
// `currentMonthApiCallCount` / `currentMonthApiCostJpy` を 0 にリセット。
// 同 cron が `scheduledPlanChangeAt <= 当日` のテナントに対し
// `scheduledNextPlan` を `plan` に適用 (ダウングレード遅延適用)。
//
// 設計判断: tenantId は v1 では DB DEFAULT で default-tenant の UUID を注入し、
// 既存コードを変更せずに単一テナント運用を可能にする。v1.x で DEFAULT を外す。

model Tenant {
  id                                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// URL ルーティング用 slug。v1 は 'default' 固定、v1.x で複数テナント対応時に動的解決。
  slug                                 String    @unique @db.VarChar(60)
  name                                 String    @db.VarChar(100)
  /// PR-X1 (2026-05-07): 顧客向け人間可読連番 (案 D / ROLE_REFACTORING_PLAN.md §2.3-bis)。
  ///   default-tenant=1 (固定 seed)、新規顧客は SEQUENCE で 2, 3, 4, ... 自動採番。
  ///   管理テナント (Knowledge Relay Platform) は null (顧客連番外)。
  ///   表示用 (請求書 / サポート / admin ダッシュボード一覧) のみで参照。
  ///   内部参照 (FK / 認可) は引き続き UUID id を使う。
  tenantSeq                            Int?      @unique @map("tenant_seq")
  /// 'beginner' | 'expert' | 'pro'
  plan                                 String    @default("beginner") @db.VarChar(20)
  currentMonthApiCallCount             Int       @default(0) @map("current_month_api_call_count")
  currentMonthApiCostJpy               Int       @default(0) @map("current_month_api_cost_jpy")
  /// ユーザ自己設定の月次予算上限 (円)。NULL = 無制限。withMeteredLLM が予測コスト超過チェックで参照。
  monthlyBudgetCapJpy                  Int?      @map("monthly_budget_cap_jpy")
  /// Beginner プランの月間 API 呼び出し回数上限 (default **50**、ADR-0019 改定: 100 → 50)。
  /// 上限カウント対象は **課金対象 featureUnit のみ** (= `BILLABLE_FEATURE_UNITS`)。
  /// 無料の embedding / chat / backfill は本カウンタを進めない。
  /// プラン契約変更時のみ書き換え。
  beginnerMonthlyCallLimit             Int       @default(50) @map("beginner_monthly_call_limit")
  /// Beginner プランの最大席数 (default 5)。User.tenantId が同じカウントで判定。
  beginnerMaxSeats                     Int       @default(5) @map("beginner_max_seats")
  /// per-API-call 単価 (円整数)。
  /// 2026-05-15 改定: Expert ¥10 → ¥5 / Pro ¥30 → ¥15 (= 半額化、ユーザ採用ハードル削減)。
  /// ADR-0019 改定 (2026-05-24): Expert ¥5 → **¥10** / Pro ¥15 据置。
  ///   課金対象を `BILLABLE_FEATURE_UNITS` (project-upsert / suggestion-explanation /
  ///   auto-tag-extract) に限定し、それ以外の embedding 系を全プラン無料化したことに
  ///   合わせて Expert 単価を 2 倍に上げた。詳細は ADR-0019。
  pricePerCallHaiku                    Int       @default(10) @map("price_per_call_haiku")
  pricePerCallSonnet                   Int       @default(15) @map("price_per_call_sonnet")
  /// P-G (2026-05-08): 請求先情報。super_admin の請求業務 (CSV エクスポート / 請求書手作成) で使用。
  ///   - 既存テナント (default-tenant / management) は migration 後 null のまま
  ///     (運営内部のため請求対象外、空 OK)。
  ///   - 新規顧客テナント (P-G で実装される super_admin 作成 API + /signup) は登録時に
  ///     必須 4 項目 (companyName / contactName / contactEmail / address) を要求する。
  ///   - 別テーブル化せず Tenant に持たせるのは、1:1 関係 + 操作頻度低 + JOIN 回避のため。
  /// 2026-05-09 (PR C / #5): 請求先種別。'corporate' (法人) / 'individual' (個人)。
  ///   - corporate: billingCompanyName 必須
  ///   - individual: billingCompanyName は不要 (UI 非表示)、billingContactName が個人氏名
  billingType                          String    @default("corporate") @map("billing_type") @db.VarChar(20)
  /// 請求書発行先の正式会社名 / 法人名 (Tenant.name は表示用のため、請求文書では本フィールドを優先)。
  /// billingType='individual' のときは UI 非表示 + 任意 (NULL 可)。
  billingCompanyName                   String?   @map("billing_company_name") @db.VarChar(200)
  /// 請求書送付先担当者名 (個人プランでは個人氏名、法人プランでは経理担当者など)
  billingContactName                   String?   @map("billing_contact_name") @db.VarChar(100)
  /// 請求書送付先メールアドレス (= 請求書 PDF / 案内メールの送り先)
  billingContactEmail                  String?   @map("billing_contact_email") @db.VarChar(255)
  /// 2026-05-09 (PR C / #8) で **構造化** 。新規入力はサブフィールドへ。
  /// Legacy: 旧 単一 Text 住所。データ損失防止のためフォールバック表示用に残置。
  billingAddress                       String?   @map("billing_address") @db.Text
  /// 郵便番号 (例 100-0001)。#8 で構造化追加
  billingPostalCode                    String?   @map("billing_postal_code") @db.VarChar(10)
  /// 都道府県 (例 東京都)。#8
  billingPrefecture                    String?   @map("billing_prefecture") @db.VarChar(20)
  /// 市区町村 (例 千代田区)。#8
  billingCity                          String?   @map("billing_city") @db.VarChar(100)
  /// 番地・町名 (例 千代田1-1)。#8
  billingStreetAddress                 String?   @map("billing_street_address") @db.VarChar(200)
  /// 建物名・部屋番号 (任意 #10)
  billingBuildingName                  String?   @map("billing_building_name") @db.VarChar(200)
  /// 連絡先電話番号 (任意)
  billingPhoneNumber                   String?   @map("billing_phone_number") @db.VarChar(20)
  /// 支払い方法 ('invoice' = 銀行振込（請求書送付） / 'credit_card' = 自動引落)。
  /// 旧 'bank_transfer' は 'invoice' に統合 (UI ラベル「銀行振込」, 内部値 'invoice')。
  /// 既存 'bank_transfer' 値は読み込み時 'invoice' と同等扱い、PATCH 時に invoice に正規化。
  paymentMethod                        String    @default("invoice") @map("payment_method") @db.VarChar(30)
  /// プラン変更予約: ダウングレード時のみ翌月適用 (Expert/Pro → Beginner)。
  scheduledPlanChangeAt                DateTime? @map("scheduled_plan_change_at") @db.Timestamptz
  scheduledNextPlan                    String?   @map("scheduled_next_plan") @db.VarChar(20)
  /// 月初リセット cron が処理した最後の月初 (UTC ベース、毎月 1 日 00:00 UTC)。
  lastResetAt                          DateTime? @map("last_reset_at") @db.Timestamptz
  /// P-B (2026-05-08): Beginner プラン永続利用防止。
  ///   - 計測起点: createdAt から 60/75/90 日経過判定で警告メール送信 + 90 日で read-only モード
  ///   - true 化条件: Tenant が一度でも Beginner 以外 (Expert/Pro) になった (= ダウングレードでも Beginner に戻せない)
  ///   - 解約済テナント (deletedAt セット) の billingContactEmail で同 email 再登録時の Beginner 拒否判定にも使用
  beginnerEverUpgraded                 Boolean   @default(false) @map("beginner_ever_upgraded")
  /// P-B: 60 日警告メール送信日時 (重複送信防止用、null なら未送信)
  beginnerNoticeDay60SentAt            DateTime? @map("beginner_notice_day60_sent_at") @db.Timestamptz
  /// P-B: 75 日警告メール送信日時
  beginnerNoticeDay75SentAt            DateTime? @map("beginner_notice_day75_sent_at") @db.Timestamptz
  /// P-B: 90 日経過 read-only 通知メール送信日時
  beginnerExpiredNoticeSentAt          DateTime? @map("beginner_expired_notice_sent_at") @db.Timestamptz
  /// 2026-05-11: 自動物理削除予告メール (150 日経過 = 削除 30 日前)
  beginnerAutoDeleteNoticeDay150SentAt DateTime? @map("beginner_auto_delete_notice_day150_sent_at") @db.Timestamptz
  /// 2026-05-11: 自動物理削除予告メール (170 日経過 = 削除 10 日前、最終警告)
  beginnerAutoDeleteNoticeDay170SentAt DateTime? @map("beginner_auto_delete_notice_day170_sent_at") @db.Timestamptz
  /// PR G (#24 / 2026-05-09): 提案エンジンに **管理テナントのシードデータ** を含めるか。
  ///   - true (default): 提案候補に管理テナントの isSampleData=true なデータを横断検索
  ///   - false:          管理テナントを除外し、自テナント + 他顧客テナントのデータのみで提案
  ///
  /// 設計合意 B (2026-05-09): シード実データは管理テナント (MANAGEMENT_TENANT_ID) に集中。
  ///   このフラグはテナント管理者が「契約直後の宇宙人感を抑える」「業務に近いシードを使いたくない」
  ///   等のニーズに応じてシード参照を遮断するための toggle。
  seedDataEnabled                      Boolean   @default(true) @map("seed_data_enabled")
  /// P-D (2026-05-08): データインポート進行中の in-flight ロック。
  ///   - 開始時 NOW() / 終了時 NULL に戻す。クラッシュ残留対策のためタイムスタンプ型。
  ///   - 30 分 (IMPORT_LOCK_STALE_MINUTES) 以上経過した値は自動失効扱い。
  importInProgressAt                   DateTime? @map("import_in_progress_at") @db.Timestamptz
  /// Storage add-on (Phase 2 / 2026-05-08): LLM プランと独立した容量プラン。
  ///   - 'standard' (default): LLM プラン連動 (Beginner 50MB / Expert 150MB / Pro 300MB)
  ///   - 'plus':       Standard + 200MB 拡張 (+¥500/月)
  ///   - 'pro_storage': Standard + 1GB 拡張 (+¥1500/月)
  ///   - 'enterprise': Standard + 5GB 拡張 (+¥5000/月)
  ///   ※ enum 名は LLM の 'pro' と衝突しないよう 'pro_storage' とする
  storageAddonPlan                     String    @default("standard") @map("storage_addon_plan") @db.VarChar(20)
  /// Storage 使用量 (バイト)。日次 cron (`updateAllStorageBytesUsed`) で `pg_column_size`
  /// 集計で更新。インポート/作成時のリアルタイム更新は重いので避けてキャッシュ運用。
  storageBytesUsed                     BigInt    @default(0) @map("storage_bytes_used")
  /// 最終更新時刻 (UI 表示で「○分前」を出すため、また stale 判定で on-demand 再計算するため)
  storageBytesUsedAt                   DateTime? @map("storage_bytes_used_at") @db.Timestamptz
  /// 上限超過 → Grace period 開始日時 (P-B 風、null=正常)。Grace 7 日経過後に write 停止。
  storageGracePeriodStartedAt          DateTime? @map("storage_grace_period_started_at") @db.Timestamptz
  /// 超過通知メール送信日時 (重複送信防止)
  storageOverLimitNoticeSentAt         DateTime? @map("storage_over_limit_notice_sent_at") @db.Timestamptz
  /// ダウングレード予約日時 (= 翌月 1 日 UTC)
  scheduledStorageAddonAt              DateTime? @map("scheduled_storage_addon_at") @db.Timestamptz
  /// ダウングレード後のプラン名 (= scheduledStorageAddonAt と対)
  scheduledNextStorageAddon            String?   @map("scheduled_next_storage_addon") @db.VarChar(20)
  /// PR-1 (2026-05-15): テナント全体の IANA タイムゾーン名。
  ///   全ユーザの日付表示・残日数計算・月初リセット境界に使用する。
  ///   default 'Asia/Tokyo'。テナント管理者が /settings/tenant から変更可。
  timezone                             String    @default("Asia/Tokyo") @map("timezone") @db.VarChar(60)
  /// PR-1 (2026-05-15): テナント全体の BCP 47 ロケール (例 'ja-JP' / 'en-US')。
  ///   default 'ja-JP'。テナント管理者が /settings/tenant から変更可。
  locale                               String    @default("ja-JP") @map("locale") @db.VarChar(10)
  createdAt                            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                            DateTime? @map("deleted_at") @db.Timestamptz
  /// 2026-05-14 (PR #372): 支払い滞納等による read-only 強制移行フラグ。
  ///   null = 通常運用 (= 書き込み可)
  ///   not null = read-only モード (write系 HTTP method を middleware で 403 遮断)
  ///   セット時刻 = super_admin が POST /api/admin/super/tenants/:id/suspend を実行した時刻
  ///   解除は POST .../resume (suspendedAt=null, resumedAt=now をセット)
  ///   関連: docs/business/PAYMENT_TERMS.md §2.3, docs/operations/PAYMENT_DELINQUENCY_SOP.md §3
  suspendedAt                          DateTime? @map("suspended_at") @db.Timestamptz
  /// 停止理由コード (例: 'payment_delinquent' / 'tos_violation' / 'other')。停止時に必須、解除時 null。
  ///   将来的に enum 化を検討するが v1 では String で柔軟運用。
  suspendReason                        String?   @map("suspend_reason") @db.VarChar(50)
  /// 停止を実行した super_admin の User.id (監査用)。auditLog にも別途記録するが、参照しやすさのため Tenant 自身にも保持。
  suspendedBy                          String?   @map("suspended_by") @db.Uuid
  /// 直近の解除時刻 (監査用)。null = 一度も停止 → 解除されていない。
  ///   suspendedAt とのペア: (suspendedAt=null, resumedAt=2026-06-01) = 6/1 に解除済の通常運用状態
  resumedAt                            DateTime? @map("resumed_at") @db.Timestamptz

  /// ADR-0016 Revised (2026-05-22): テナント払い出し時の初期 admin User.id を保持。
  ///   公開セルフサインアップ (/api/auth/signup) からの「自前テナント保有」3 層判定で参照される。
  ///   - 公開 /signup と super_admin /admin/super/tenants 両経路で onboarding service が必ずセット
  ///   - 既存テナント (MANAGEMENT / Default) は migration 同梱の backfill SQL で最古 admin を設定
  ///   - User.id への FK にしない (= suspendedBy と同じ設計。User 物理削除時に宙吊りになっても
  ///     既に「自前テナント保有」のフラグ自体は残るため層判定に支障なし)
  ///   - NULLABLE: backfill が漏れたテナントを silent fail させないため、最終的に NOT NULL 化は
  ///     将来 ADR で検討 (本 migration では既存運用への影響回避を優先)
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  // ============================================================
  // Stripe Metered Billing 連携 (PR-S1 / 2026-05-14)
  // 関連: docs/business/STRIPE_BILLING.md / docs/design/STRIPE_TECHNICAL_DESIGN.md
  //
  // 設計方針:
  //   - 全カラム NULLABLE (= invoice / bank_transfer テナントには影響なし、credit_card 切替時のみ値セット)
  //   - feature flag (STRIPE_ENABLED 環境変数) が false なら、UI / API レベルで使用不可
  //   - migration 適用後も既存テナントへの影響ゼロ
  // ============================================================
  /// Stripe Customer ID。credit_card 払いに切替えた時点で作成。null = 未登録。
  ///   1 テナント = 1 Stripe Customer の前提 (UNIQUE 制約)
  stripeCustomerId                String?   @unique @map("stripe_customer_id") @db.VarChar(50)
  /// Stripe Subscription ID。プラン契約時に作成、削除時に null へ。
  ///   1 テナント = 1 Active Subscription (UNIQUE 制約)
  stripeSubscriptionId            String?   @unique @map("stripe_subscription_id") @db.VarChar(50)
  /// Subscription の状態 ('active' / 'past_due' / 'canceled' / 'incomplete' / 'trialing' 等)。
  ///   Webhook customer.subscription.updated で同期更新
  stripeSubscriptionStatus        String?   @map("stripe_subscription_status") @db.VarChar(30)
  /// Haiku (Expert plan) per-call Subscription Item ID。Metered Billing の Usage Record 送信先
  stripeSubscriptionItemHaikuId   String?   @map("stripe_subscription_item_haiku_id") @db.VarChar(50)
  /// Sonnet (Pro plan) per-call Subscription Item ID
  stripeSubscriptionItemSonnetId  String?   @map("stripe_subscription_item_sonnet_id") @db.VarChar(50)
  /// Storage add-on (月固定額) Subscription Item ID。standard プランも形式的に存在
  stripeSubscriptionItemStorageId String?   @map("stripe_subscription_item_storage_id") @db.VarChar(50)
  /// Default Payment Method ID (= デフォルトの請求用カード)。Stripe Checkout 登録後に保存
  stripeDefaultPaymentMethodId    String?   @map("stripe_default_payment_method_id") @db.VarChar(50)
  /// 直近のカード検証成功時刻 (プラン変更時 + 月初検証 cron が更新)
  cardLastVerifiedAt              DateTime? @map("card_last_verified_at") @db.Timestamptz
  /// カード検証状態: 'valid' / 'expired' / 'declined' / 'never_verified'
  cardVerificationStatus          String?   @map("card_verification_status") @db.VarChar(20)
  /// Smart Retries 全失敗後の自動 suspend 予定時刻 (= Webhook customer.subscription.updated で
  ///   status='past_due' 受信時に now+3日 をセット)
  ///   日次 cron がこれを参照して既存 suspendTenant() を自動呼出
  autoSuspendScheduledAt          DateTime? @map("auto_suspend_scheduled_at") @db.Timestamptz

  // Relations: 13 業務エンティティ + ApiCallLog + SuggestionExplanation (P-3) + monthlyUsageHistory (P-5b)
  // Phase 2-10 (2026-05-10): 監査・トークン系 7 model も back-relation を追加
  users                   User[]
  customers               Customer[]
  projects                Project[]
  knowledges              Knowledge[]
  risksIssues             RiskIssue[]
  retrospectives          Retrospective[]
  memos                   Memo[]
  stakeholders            Stakeholder[]
  comments                Comment[]
  mentions                Mention[]
  notifications           Notification[]
  attachments             Attachment[]
  systemErrorLogs         SystemErrorLog[]
  apiCallLogs             ApiCallLog[]
  suggestionExplanations  SuggestionExplanation[]
  monthlyUsageHistory     TenantMonthlyUsageHistory[]
  importPreviews          TenantImportPreview[]
  auditLogs               AuditLog[]
  roleChangeLogs          RoleChangeLog[]
  authEventLogs           AuthEventLog[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  recoveryCodes           RecoveryCode[]
  passwordHistories       PasswordHistory[]
  // Stripe 連携 (PR-S1 / 2026-05-14)
  billingHistories        BillingHistory[]
  stripeUsageRecordQueue  StripeUsageRecordQueue[]
  // 規約・プラポリ同意ログ (feat/legal-pages-lp-integration / 2026-05-21)
  consentLogs             TenantConsentLog[]

  @@index([plan], map: "idx_tenants_plan")
  // PR-S1: credit_card テナントの絞り込み用 (= Stripe 連携対象のクエリで使用)
  @@index([stripeSubscriptionStatus], map: "idx_tenants_stripe_subscription_status")
  @@map("tenants")
}

// ============================================================
// Users & Authentication
// ============================================================

model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // PR #2 (T-03): マルチテナント基盤。v1 では DB DEFAULT で default-tenant に自動配属。
  // v1.x で UI 由来のテナント割当が必要になったタイミングで DEFAULT を外す。
  tenantId            String    @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  name                String    @db.VarChar(100)
  email               String    @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  systemRole          String    @default("general") @map("system_role") @db.VarChar(20)
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginCount    Int       @default(0) @map("failed_login_count")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz
  // T-21 (2026-04-28): 一時ロック発生回数の累積カウンタ。
  //   permanentLock 発火経路の起点 (5.29 選択肢 A)。
  //   閾値到達 (PERMANENT_LOCK_THRESHOLD=3) で permanentLock=true にセット。
  //   ログイン成功時に 0 にリセット (一時ロックを乗り越えて成功した = 正規ユーザの可能性)。
  temporaryLockCount  Int       @default(0) @map("temporary_lock_count")
  permanentLock       Boolean   @default(false) @map("permanent_lock")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEncrypted  String?   @map("mfa_secret_encrypted") @db.VarChar(255)
  mfaEnabledAt        DateTime? @map("mfa_enabled_at") @db.Timestamptz
  // PR #116 (2026-04-24): MFA verify 総当たり対策。パスワードロックとは別系統。
  //   - 3 回連続失敗で 30 分ロック (mfaLockedUntil に解除時刻をセット)
  //   - 正しい TOTP or recovery code 入力で 0 にリセット
  //   - 恒久ロックは設けない (recovery code 経路で自己解除可能なため)
  mfaFailedCount      Int       @default(0) @map("mfa_failed_count")
  mfaLockedUntil      DateTime? @map("mfa_locked_until") @db.Timestamptz
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  forcePasswordChange Boolean   @default(false) @map("force_password_change")
  // 2026-05-13 (security/jwt-invalidation, L-1): JWT 失効カウンタ。
  //   ログイン時に JWT に格納し、API route 経由のリクエスト時に DB の最新値と比較。
  //   不一致なら 401 を返してログアウト誘導する。
  //   admin による「強制ログアウト」操作 (パスワード変更 / ロック解除 / ユーザ削除 / ロール変更) で
  //   `{ increment: 1 }` し、当該ユーザの既存 JWT を全て即時失効させる。
  //   middleware (Edge runtime) は DB アクセス不可のため検証できないが、API route 入口の
  //   getAuthenticatedUser で DB 比較する設計で、機微操作 (write 系) は確実に弾く。
  tokenVersion        Int       @default(0) @map("token_version")
  // PR #72: 画面テーマ設定。既定 'light' (ライトテーマ)。ユーザが明示的に変更した
  // 値がセッションをまたいで永続適用されるため、sessionStorage ではなく DB 永続化する。
  themePreference     String    @default("light") @map("theme_preference") @db.VarChar(30)
  // PR-1 (2026-05-15): timezone / locale はテナント単位 (Tenant.timezone / Tenant.locale) に
  //   集約されたため User からは撤去。同一テナント内のユーザは同じ TZ/locale で運用する。
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  projectMembers          ProjectMember[]          @relation("UserProjectMembers")
  assignedTasks           Task[]                   @relation("TaskAssignee")
  taskProgressLogs        TaskProgressLog[]        @relation("ProgressUpdater")
  reportedRisks           RiskIssue[]              @relation("RiskReporter")
  assignedRisks           RiskIssue[]              @relation("RiskAssignee")
  createdKnowledges       Knowledge[]              @relation("KnowledgeCreator")
  updatedKnowledges       Knowledge[]              @relation("KnowledgeUpdater")
  auditLogs               AuditLog[]
  authEventLogs           AuthEventLog[]
  systemErrorLogs         SystemErrorLog[]
  roleChangesPerformed    RoleChangeLog[]          @relation("RoleChanger")
  roleChangesReceived     RoleChangeLog[]          @relation("RoleTarget")
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  recoveryCodes           RecoveryCode[]
  passwordHistories       PasswordHistory[]
  addedAttachments        Attachment[]             @relation("AttachmentAddedBy")
  memos                   Memo[]                   @relation("MemoAuthor")
  stakeholderRecords      Stakeholder[]            @relation("StakeholderUser")
  authoredComments        Comment[]                @relation("CommentAuthor")
  notifications           Notification[]           @relation("NotificationRecipient")
  receivedMentions        Mention[]                @relation("MentionTarget")
  apiCallLogs             ApiCallLog[]             @relation("ApiCallLogActor")
  generatedExplanations   SuggestionExplanation[]  @relation("SuggestionExplanationGeneratedBy")
  importPreviews          TenantImportPreview[]    @relation("TenantImportPreviewCreator")

  // PR #2: tenant への back relation
  tenant Tenant @relation(fields: [tenantId], references: [id])

  // ADR-0016 (2026-05-20): User.email を tenant-scoped 一意に変更
  //   旧 @@unique([email]) はグローバル一意 → 同一個人が複数テナント所属不可、
  //   テナント削除後の email 再利用で UNIQUE 違反 → 500 等の問題があった。
  //   tenant-scoped にすることで Slack/Notion/GitHub Org 系の標準設計に整合。
  @@unique([tenantId, email], map: "idx_users_tenant_email")
  @@index([isActive, lastLoginAt], map: "idx_users_active")
  @@index([tenantId], map: "idx_users_tenant")
  // ADR-0016: tenant ambiguity 防止のため email 単独検索を廃止
  //   (= グローバル email lookup は不可能 = pre-auth フローで tenantId 必須化)
  @@map("users")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(255)
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user")
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Phase 2-10 (2026-05-10): tenantId 必須化。token 漏洩時の越境再利用を遮断するため、
  //   検証経路 (findFirst({ where: { tokenHash, tenantId } })) で必ずフィルタする。
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "idx_email_verification_tokens_tenant")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Phase 2-10 (2026-05-10): tenantId 必須化。token 越境再利用遮断。
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "idx_password_reset_tokens_tenant")
  @@map("password_reset_tokens")
}

model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Phase 2-10 (2026-05-10): tenantId 必須化。
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "idx_recovery_codes_tenant")
  @@map("recovery_codes")
}

model PasswordHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Phase 2-10 (2026-05-10): tenantId 必須化。
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId], map: "idx_password_histories_tenant")
  @@map("password_histories")
}

// ============================================================
// Customers (PR #111)
// ============================================================
//
// 顧客管理。プロジェクトは必ず顧客に紐付く (1 顧客 : N プロジェクト)。
//
// 運用:
//   - システム管理者 (systemRole='admin') のみ CRUD 可能
//   - 物理削除方針 (論理削除列を持たない、Project とは別)
//   - 顧客削除 → 紐付く Project は既存 deleteProjectCascade で論理削除 (PR #111-2 で実装)
//   - 物理削除時の FK 整合性は Project.customer_id の ON DELETE SET NULL で担保
//     (論理削除済み Project も customer_id が dangling にならない)
//
// 設計方針: docs/developer/DESIGN.md の Customer 節参照 (PR #111-2 で追記)

model Customer {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // PR #2: tenant 配属 (DEFAULT default-tenant)
  tenantId      String   @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  name          String   @db.VarChar(100)
  department    String?  @db.VarChar(100)
  contactPerson String?  @map("contact_person") @db.VarChar(100)
  contactEmail  String?  @map("contact_email") @db.VarChar(255)
  notes         String?  @db.Text
  createdBy     String   @map("created_by") @db.Uuid
  updatedBy     String   @map("updated_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  projects Project[]

  @@index([name], map: "idx_customers_name")
  @@index([tenantId], map: "idx_customers_tenant")
  @@map("customers")
}

// ============================================================
// Projects
// ============================================================

model Project {
  id                 String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // PR #2: tenant 配属 (DEFAULT default-tenant)
  tenantId           String                       @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  name               String                       @db.VarChar(100)
  // PR #111-2: customer_name 列を廃止し Customer テーブルへの FK に完全移行。
  // ON DELETE SET NULL: Customer 物理削除時、論理削除済み Project (deletedAt != null) の
  // customer_id が dangling にならないよう明示的に null 化する。
  // アクティブな Project (deletedAt = null) を抱える Customer は削除不可、
  // もしくは deleteCustomerCascade で関連資源を一括カスケード削除してから削除する。
  // その結果 customerId は運用上 NOT NULL を保証できる。
  customerId         String                       @map("customer_id") @db.Uuid
  customer           Customer                     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  purpose            String                       @db.Text
  background         String                       @db.Text
  scope              String                       @db.Text
  outOfScope         String?                      @map("out_of_scope") @db.Text
  devMethod          String                       @map("dev_method") @db.VarChar(30)
  // 項目 14 (PR-β): 契約形態 (準委任 / 請負 / SES / そのほか)。既存 Project は null 許容で後付け。
  contractType       String?                      @map("contract_type") @db.VarChar(30)
  businessDomainTags Json                         @default("[]") @map("business_domain_tags") @db.JsonB
  techStackTags      Json                         @default("[]") @map("tech_stack_tags") @db.JsonB
  // PR #65: 新規プロジェクト作成時にナレッジ/過去課題を提案するため、
  // Knowledge と同じ粒度の工程タグも持たせる。Jaccard 類似度 + pg_trgm
  // テキスト類似度の併用で核心機能 (提案型サービス) を実現する。
  processTags        Json                         @default("[]") @map("process_tags") @db.JsonB
  plannedStartDate   DateTime                     @map("planned_start_date") @db.Date
  plannedEndDate     DateTime                     @map("planned_end_date") @db.Date
  status             String                       @default("planning") @db.VarChar(20)
  notes              String?                      @db.Text
  // PR-X5 (2026-05-07): シードデータ用のサンプルプロジェクト識別フラグ。
  //   true のサンプルプロジェクトは:
  //     - プロジェクト一覧 (`/projects`) / 全課題 / 全リスク / 全振り返り から非表示
  //     - 直接 URL アクセス (`/projects/[id]`) でも 404
  //     - **提案エンジン (参考タブ / 提案モーダル) では候補として可視** (= 設計目的)
  //   default false で既存プロジェクトに影響なし。新規シーディング時のみ true で投入される。
  isSampleData       Boolean                      @default(false) @map("is_sample_data")
  // PR #4 (T-03 Phase 2): purpose / background / scope を結合した text の Voyage AI
  //   embedding (1024 次元、voyage-4-lite)。Cosine Similarity による意味検索の基盤。
  //   生成失敗時 NULL を許容 (本体 INSERT/UPDATE は成功させる fail-safe)。
  contentEmbedding   Unsupported("vector(1024)")? @map("content_embedding")
  createdBy          String                       @map("created_by") @db.Uuid
  updatedBy          String                       @map("updated_by") @db.Uuid
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?                    @map("deleted_at") @db.Timestamptz

  // Relations
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  members                ProjectMember[]
  estimates              Estimate[]
  tasks                  Task[]
  // PR feat/asset-multi-project-linking: `risksIssues` / `retrospectives` は **作成元** が
  //   このプロジェクトである行のみを返す (新仕様)。プロジェクトが「参照中」の資産一覧は
  //   `riskIssueProjects` / `retrospectiveProjects` (M:N 中間) を辿ること。
  risksIssues            RiskIssue[]
  retrospectives         Retrospective[]
  riskIssueProjects      RiskIssueProject[]
  retrospectiveProjects  RetrospectiveProject[]
  knowledgeProjects      KnowledgeProject[]
  stakeholders           Stakeholder[]
  suggestionExplanations SuggestionExplanation[]

  @@index([status], map: "idx_projects_status")
  @@index([customerId], map: "idx_projects_customer_id")
  @@index([plannedStartDate, plannedEndDate], map: "idx_projects_dates")
  @@index([tenantId], map: "idx_projects_tenant")
  // PR-X5: サンプルデータの非表示フィルタを高速化する partial index (true の行のみ index)
  @@index([isSampleData], map: "idx_projects_is_sample_data")
  @@map("projects")
}

// ============================================================
// Estimates
// ============================================================

model Estimate {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  itemName        String    @map("item_name") @db.VarChar(100)
  category        String    @db.VarChar(30)
  devMethod       String    @map("dev_method") @db.VarChar(30)
  estimatedEffort Decimal   @map("estimated_effort") @db.Decimal(10, 2)
  effortUnit      String    @map("effort_unit") @db.VarChar(20)
  rationale       String    @db.Text
  preconditions   String?   @db.Text
  isConfirmed     Boolean   @default(false) @map("is_confirmed")
  notes           String?   @db.Text
  createdBy       String    @map("created_by") @db.Uuid
  updatedBy       String    @map("updated_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId], map: "idx_estimates_project")
  @@map("estimates")
}

model ProjectMember {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  projectRole String   @map("project_role") @db.VarChar(20)
  assignedBy  String   @map("assigned_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation("UserProjectMembers", fields: [userId], references: [id])

  @@unique([projectId, userId], map: "uq_pm_project_user")
  @@index([projectId], map: "idx_pm_project")
  @@index([userId], map: "idx_pm_user")
  @@map("project_members")
}

// ============================================================
// Tasks / WBS
// ============================================================

model Task {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  parentTaskId     String?   @map("parent_task_id") @db.Uuid
  type             String    @default("activity") @db.VarChar(20) // work_package | activity
  wbsNumber        String?   @map("wbs_number") @db.VarChar(50)
  name             String    @db.VarChar(100)
  description      String?   @db.Text
  category         String    @db.VarChar(30)
  assigneeId       String?   @map("assignee_id") @db.Uuid // WP は null、ACT は必須
  plannedStartDate DateTime? @map("planned_start_date") @db.Date // WP は子から自動計算
  plannedEndDate   DateTime? @map("planned_end_date") @db.Date // WP は子から自動計算
  actualStartDate  DateTime? @map("actual_start_date") @db.Date
  actualEndDate    DateTime? @map("actual_end_date") @db.Date
  plannedEffort    Decimal   @default(0) @map("planned_effort") @db.Decimal(10, 2) // WP は子の合計
  priority         String?   @default("medium") @db.VarChar(10)
  status           String    @default("not_started") @db.VarChar(20)
  progressRate     Int       @default(0) @map("progress_rate") // WP は子の加重平均
  isMilestone      Boolean   @default(false) @map("is_milestone")
  notes            String?   @db.Text
  createdBy        String    @map("created_by") @db.Uuid
  updatedBy        String    @map("updated_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  project        Project           @relation(fields: [projectId], references: [id])
  parentTask     Task?             @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  childTasks     Task[]            @relation("TaskHierarchy")
  assignee       User?             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  progressLogs   TaskProgressLog[]
  taskKnowledges TaskKnowledge[]

  @@index([projectId], map: "idx_tasks_project")
  @@index([assigneeId, status], map: "idx_tasks_assignee")
  @@index([parentTaskId], map: "idx_tasks_parent")
  @@index([projectId, plannedStartDate, plannedEndDate], map: "idx_tasks_gantt")
  // 2026-05-25 [C3]: (project_id, parent_task_id, name) WHERE deleted_at IS NULL の部分 UNIQUE
  //   インデックスを raw SQL migration (20260525_tasks_unique_parent_name) で追加済。
  //   Prisma の @@unique は WHERE 句を表現できないため schema 側ではコメント記録のみ。
  @@map("tasks")
}

model TaskProgressLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId          String    @map("task_id") @db.Uuid
  updatedBy       String    @map("updated_by") @db.Uuid
  updateDate      DateTime  @map("update_date") @db.Date
  progressRate    Int       @map("progress_rate")
  actualEffort    Decimal   @map("actual_effort") @db.Decimal(10, 2)
  remainingEffort Decimal?  @map("remaining_effort") @db.Decimal(10, 2)
  status          String    @db.VarChar(20)
  isDelayed       Boolean   @default(false) @map("is_delayed")
  delayReason     String?   @map("delay_reason") @db.Text
  workMemo        String?   @map("work_memo") @db.Text
  hasIssue        Boolean   @default(false) @map("has_issue")
  nextAction      String?   @map("next_action") @db.Text
  completedDate   DateTime? @map("completed_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  task    Task @relation(fields: [taskId], references: [id])
  updater User @relation("ProgressUpdater", fields: [updatedBy], references: [id])

  @@index([taskId, updateDate(sort: Desc)], map: "idx_progress_task")
  @@map("task_progress_logs")
}

// ============================================================
// Risks & Issues
// ============================================================

model RiskIssue {
  id               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // PR #2: tenant 配属 (DEFAULT default-tenant)
  tenantId         String                       @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  // PR feat/asset-multi-project-linking (2026-05-09):
  //   M:N 化に伴い「**作成元プロジェクト** (createdInProject)」の意味に変更。nullable + SET NULL。
  //   作成元 project が物理削除された後はこの値が NULL となり、資産は他リンクが残れば生存する。
  //   全プロジェクトから紐付け解除された場合の orphan 状態を許容する (ユーザ要件)。
  projectId        String?                      @map("project_id") @db.Uuid
  type             String                       @db.VarChar(10) // risk | issue
  title            String                       @db.VarChar(100)
  content          String                       @db.Text
  cause            String?                      @db.Text
  impact           String                       @db.VarChar(10) // low | medium | high
  likelihood       String?                      @db.VarChar(10)
  priority         String                       @db.VarChar(10) // low | medium | high
  responsePolicy   String?                      @map("response_policy") @db.Text
  responseDetail   String?                      @map("response_detail") @db.Text
  reporterId       String                       @map("reporter_id") @db.Uuid
  assigneeId       String?                      @map("assignee_id") @db.Uuid
  deadline         DateTime?                    @db.Date
  state            String                       @default("open") @db.VarChar(20)
  result           String?                      @db.Text
  lessonLearned    String?                      @map("lesson_learned") @db.Text
  visibility       String                       @default("draft") @db.VarChar(20) // draft | public (PR #60)
  riskNature       String?                      @map("risk_nature") @db.VarChar(20) // threat | opportunity (type=risk のみ)
  // PR #4 (T-03 Phase 2): title + content + cause + lessonLearned 等を結合した text の embedding
  contentEmbedding Unsupported("vector(1024)")? @map("content_embedding")
  createdBy        String                       @map("created_by") @db.Uuid
  updatedBy        String                       @map("updated_by") @db.Uuid
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?                    @map("deleted_at") @db.Timestamptz

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  // PR feat/asset-multi-project-linking (2026-05-09):
  //   `projectId` は M:N 化に伴い「**作成元プロジェクト** (audit/UI 上の起源表示用)」に意味が変わる。
  //   検索 / 一覧 / cascade 駆動はすべて `riskIssueProjects` (中間テーブル) 経由になる。
  //   従って `Project @relation` は audit 用に残すが、code 上は `riskIssueProjects: { some: { projectId } }`
  //   形のフィルタを使用すること。直接 `where: { projectId }` は **作成元一致** を意味する別概念。
  //   ON DELETE SET NULL: 作成元 project 物理削除時に projectId は NULL になる (orphan 許容)。
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reporter          User               @relation("RiskReporter", fields: [reporterId], references: [id])
  assignee          User?              @relation("RiskAssignee", fields: [assigneeId], references: [id])
  riskIssueProjects RiskIssueProject[]

  @@index([projectId, type], map: "idx_risks_project")
  @@index([state, priority], map: "idx_risks_state")
  @@index([assigneeId], map: "idx_risks_assignee")
  @@index([tenantId], map: "idx_risks_tenant")
  @@map("risks_issues")
}

/// PR feat/asset-multi-project-linking (2026-05-09):
///   リスク/課題と Project の M:N 中間テーブル。Knowledge の KnowledgeProject と同設計。
///   作成時 (作成元プロジェクト=A) は (riskIssueId, A) を 1 行 insert。
///   B が「参考」タブから紐付けると (riskIssueId, B) を追加 insert。
///   A が削除される時、cascadeRisks 選択でも他に紐付けが残れば本体は残し RiskIssueProject 行のみ削除。
///   最後の紐付け解除時のみ本体 / attachment / comment が物理削除される (KnowledgeProject 既存動作と同型)。
model RiskIssueProject {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  riskIssueId String @map("risk_issue_id") @db.Uuid
  projectId   String @map("project_id") @db.Uuid

  riskIssue RiskIssue @relation(fields: [riskIssueId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([riskIssueId, projectId])
  @@index([projectId], map: "idx_risk_issue_projects_project")
  @@map("risk_issue_projects")
}

// ============================================================
// Stakeholder Management (PMBOK 13)
// feat/stakeholder-management:
//   プロジェクトに関与する全関係者を管理する。Mendelow Power/Interest grid (1-5 段階) +
//   姿勢 (賛成/中立/反対) + Engagement Gap (現在 vs 望ましい) の PMBOK 準拠フル仕様。
//   userId は内部メンバー用 (nullable)。null なら外部関係者 (顧客役員、規制機関等)。
//   可視性は service 層で PM/TL + admin に限定 (人物評を含むため)。
// ============================================================

model Stakeholder {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // PR #2: tenant 配属 (DEFAULT default-tenant)
  tenantId          String    @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  // 内部メンバーとの紐付け (任意)。null なら外部関係者。
  // ON DELETE SET NULL: User 物理削除時にステークホルダー記録は残す (人物評・履歴の保全)。
  userId            String?   @map("user_id") @db.Uuid
  // 表示用氏名: 内部紐付け時も独立した列を持つ (User.name とは別の通称・敬称付き表記を許容)
  name              String    @db.VarChar(100)
  organization      String?   @db.VarChar(100) // 所属組織 (例: 顧客企画部、規制機関名)
  role              String?   @db.VarChar(100) // 役職 (例: 部長、CTO)
  contactInfo       String?   @map("contact_info") @db.Text // 連絡先メモ
  // PMBOK Power/Interest grid: 1-5 段階で格納 (UI 4 象限分類は閾値 >= 4 で計算)
  influence         Int       @db.SmallInt // 影響度 1=最低 / 5=最高
  interest          Int       @db.SmallInt // 関心度 1=最低 / 5=最高
  // 姿勢 (賛成/中立/反対): 同じ象限でも対応戦略が変わるため
  attitude          String    @db.VarChar(20) // supportive | neutral | opposing
  // PMBOK 13.1.2 Engagement Assessment Matrix (5 段階)
  currentEngagement String    @map("current_engagement") @db.VarChar(20) // unaware|resistant|neutral|supportive|leading
  desiredEngagement String    @map("desired_engagement") @db.VarChar(20)
  // Phase D 要件 11/12 (2026-04-28): Power/Interest grid から自動分類する優先度
  // (high|medium|low)。サービス層で influence × interest から deriveStakeholderPriority
  // により計算してから保存する。一覧の sort/filter UI で利用。
  priority          String    @default("medium") @db.VarChar(10)
  // 自由記述: 人となり / 考え方 / 接し方のコツ
  personality       String?   @db.Text
  // 検索/分類タグ (例: ["技術志向", "数字派"])
  tags              Json      @default("[]") @db.JsonB
  // 戦略・対応方針 (具体的アクション)
  strategy          String?   @db.Text
  createdBy         String    @map("created_by") @db.Uuid
  updatedBy         String    @map("updated_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  user    User?   @relation("StakeholderUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId], map: "idx_stakeholders_project")
  @@index([userId], map: "idx_stakeholders_user")
  // Phase D 要件 12: 優先度フィルタの絞り込みに利用
  @@index([priority], map: "idx_stakeholders_priority")
  @@index([tenantId], map: "idx_stakeholders_tenant")
  @@map("stakeholders")
}

// ============================================================
// Knowledge
// ============================================================

model Knowledge {
  id                 String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // PR #2: tenant 配属 (DEFAULT default-tenant)
  // テナント独立性を担保するため Knowledge はテナント間で重複コピー (default-tenant の
  // シードナレッジを新規テナントに seedTenant() で複製)。設計判断は SUGGESTION_ENGINE_PLAN.md PR #6 参照。
  tenantId           String                       @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  title              String                       @db.VarChar(150)
  knowledgeType      String                       @map("knowledge_type") @db.VarChar(30)
  background         String                       @db.Text
  content            String                       @db.Text
  result             String                       @db.Text
  conclusion         String?                      @db.Text
  recommendation     String?                      @db.Text
  reusability        String?                      @db.VarChar(10)
  techTags           Json                         @default("[]") @map("tech_tags") @db.JsonB

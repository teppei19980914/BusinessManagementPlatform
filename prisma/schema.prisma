/// PR #115 (2026-04-24): 内部エラー / クライアントエラーを蓄積するテーブル。
///
/// 設計思想 (DESIGN.md §9.8.5):
///   - ブラウザの Console や Server console に機密情報 (スタック、設定、SQL 内部情報等) を出さず、
///     必ず本テーブルに保存してから、ユーザには固定文言「内部エラーが発生しました」を返す。
///   - AuditLog は userId NOT NULL で pre-auth エラーを記録できないため、
///     AuthEventLog と同じ「nullable userId + JSON detail」パターンで分離した姉妹テーブル。
///   - severity で重要度を分類 (info / warn / error / fatal)。
///   - source で発生箇所カテゴリを記録 (server / client / cron 等)。
///   - context に IP / request path / 任意メタデータを JSON で持たせる。
model SystemErrorLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // PR #2: tenant 配属 (DEFAULT default-tenant)。pre-auth エラーは default-tenant に集約。
  tenantId  String   @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  severity  String   @db.VarChar(10) // 'info' | 'warn' | 'error' | 'fatal'
  source    String   @db.VarChar(30) // 'server' | 'client' | 'cron' | 'mail' | etc.
  message   String   @db.Text
  stack     String?  @db.Text
  userId    String?  @map("user_id") @db.Uuid
  requestId String?  @map("request_id") @db.VarChar(64)
  context   Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User?  @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([severity, createdAt(sort: Desc)], map: "idx_system_errors_severity")
  @@index([source, createdAt(sort: Desc)], map: "idx_system_errors_source")
  @@index([userId, createdAt(sort: Desc)], map: "idx_system_errors_user")
  @@index([createdAt(sort: Desc)], map: "idx_system_errors_date")
  @@index([tenantId, createdAt(sort: Desc)], map: "idx_system_errors_tenant")
  @@map("system_error_logs")
}

/// PR feat/cron-execution-log (2026-05-18): cron 実行履歴を蓄積するテーブル。
///
/// 設計目的:
///   1. **可観測性**: super_admin ダッシュボードから過去の cron 実行結果を確認可能にする
///      (= cron-job.org の外部ダッシュボードに頼らず、社内で完結した監視導線)
///   2. **timeout 検知**: Netlify Functions の 10 秒上限を超えた cron は `completedAt=null` の
///      ままレコードが残るため、`status='running'` AND `startedAt < now()-30s` を検出すれば
///      timeout 疑い (= 復旧 / chunk 化等の対応に着手できる)
///   3. **失敗の根本原因追跡**: errorMessage / errorStack を Function logs と独立して保持
///
/// 設計判断:
///   - **tenantId なし**: cron は全テナント横断 (システム運用) または management tenant の運用なので
///     特定テナントへの帰属は意味を持たない。AuditLog のような tenant filter は不要
///   - **userId なし**: cron は実行主体が「システム」固定。AuditLog 系との分離を明確にする
///   - **payloadJson は結果サマリ**: 既存 cron route が返している `{ source: 'cron', ...result }`
///     をそのまま保存する。詳細な per-record データは AuditLog 側に残す
///   - **logging 失敗で cron 本体を fail させない**: withCronExecutionLogging ヘルパは
///     log 書込みの try/catch を内包し、log 失敗時は console.warn して cron 本体は継続
///
/// 関連:
///   - ヘルパ: src/lib/cron-execution-log.ts withCronExecutionLogging()
///   - UI: src/app/(dashboard)/admin/super/cron-history/page.tsx
///   - KDD: docs/knowledge/KDD_PATTERNS.md §5.X+72
model CronExecutionLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cronName     String    @map("cron_name") @db.VarChar(64) // 'lock-inactive-users', 'daily-notifications', ...
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz // null = まだ実行中 or timeout
  durationMs   Int?      @map("duration_ms") // 完了時のみ
  status       String    @db.VarChar(20) // 'running' | 'success' | 'failure'
  errorMessage String?   @map("error_message") @db.Text
  errorStack   String?   @map("error_stack") @db.Text
  // 結果サマリ JSON: cron route が NextResponse.json で返している data オブジェクトをそのまま保存
  payloadJson  Json?     @map("payload_json") @db.JsonB
  // 呼出元 IP (= cron-job.org のサーバ IP)。誤検知のセキュリティ調査用、PII ではないため保持可
  invokerIp    String?   @map("invoker_ip") @db.VarChar(45)

  @@index([cronName, startedAt(sort: Desc)], map: "idx_cron_exec_name_date")
  @@index([status, startedAt(sort: Desc)], map: "idx_cron_exec_status_date")
  @@index([startedAt(sort: Desc)], map: "idx_cron_exec_date")
  @@map("cron_execution_logs")
}

model RoleChangeLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Phase 2-10 (2026-05-10): 権限変更ログのテナント帰属 (= target user の tenant)。
  //   admin が他テナントの user を変更する経路は構造的に存在しないため、
  //   target user の tenant をそのまま使う。
  tenantId     String   @map("tenant_id") @db.Uuid
  changedBy    String   @map("changed_by") @db.Uuid
  targetUserId String   @map("target_user_id") @db.Uuid
  changeType   String   @map("change_type") @db.VarChar(20) // system_role | project_role
  projectId    String?  @map("project_id") @db.Uuid
  beforeRole   String?  @map("before_role") @db.VarChar(30)
  afterRole    String   @map("after_role") @db.VarChar(30)
  reason       String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  changer    User   @relation("RoleChanger", fields: [changedBy], references: [id])
  targetUser User   @relation("RoleTarget", fields: [targetUserId], references: [id])
  tenant     Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)], map: "idx_role_change_logs_tenant")
  @@map("role_change_logs")
}

/// 添付リンク (PR #64 Phase 1): 実ファイルは保持せず、外部ストレージの URL のみを格納する
/// ポリモーフィック関連 (entityType + entityId) で 6 種のエンティティと連携する:
///   project / task / estimate / risk / retrospective / knowledge
/// slot によって「単数」スロット (primary / source 等) と「複数」スロット (general) を
/// 同一テーブルで扱う — 単数制約は UI/サービス層で enforce する (DB は複数行を許容)。
/// 容量最適化のため 1 レコードあたり ~400B 以内に抑え、Supabase Free (DB 500MB) の
/// 長期運用に耐える設計 (DESIGN.md §21.2 DRY 原則に沿って共通テーブル化)。
model Attachment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // PR #2: tenant 配属 (DEFAULT default-tenant)。親エンティティの tenantId と整合性をサービス層で担保。
  tenantId    String    @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  entityType  String    @map("entity_type") @db.VarChar(30)
  entityId    String    @map("entity_id") @db.Uuid
  slot        String    @default("general") @db.VarChar(30)
  displayName String    @map("display_name") @db.VarChar(200)
  url         String    @db.VarChar(2000)
  mimeHint    String?   @map("mime_hint") @db.VarChar(50)
  addedBy     String    @map("added_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  addedByUser User   @relation("AttachmentAddedBy", fields: [addedBy], references: [id])
  tenant      Tenant @relation(fields: [tenantId], references: [id])

  @@index([entityType, entityId], map: "idx_attachments_entity")
  @@index([entityType, entityId, slot], map: "idx_attachments_slot")
  @@index([tenantId], map: "idx_attachments_tenant")
  @@map("attachments")
}

/// コメント (PR #199): エンティティ編集 dialog 内のディスカッション用
/// ポリモーフィック関連 (entityType + entityId) で 7 種のエンティティと連携する:
///   issue / task / risk / retrospective / knowledge / customer / stakeholder
/// 既存の `RetrospectiveComment` テーブルは本 model に統合 (data migration あり)。
/// 認可方針:
///   - 投稿: 認証済ユーザは誰でも (project member 非メンバーも可、要件 Q4)
///   - 編集 / 削除: 投稿者本人 OR システム管理者 (要件 Q5)
/// 削除: soft-delete (`deletedAt`) — 監査要件 + 編集履歴保持目的
model Comment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // PR #2: tenant 配属 (DEFAULT default-tenant)。親エンティティの tenantId と整合性をサービス層で担保。
  tenantId   String    @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  entityType String    @map("entity_type") @db.VarChar(30)
  entityId   String    @map("entity_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  content    String    @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  user     User      @relation("CommentAuthor", fields: [userId], references: [id])
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  mentions Mention[]

  @@index([entityType, entityId, deletedAt], map: "idx_comments_entity")
  @@index([tenantId], map: "idx_comments_tenant")
  @@map("comments")
}

/// メンション (PR feat/comment-mentions): コメント本文中の `@username` / `@all` 等を
/// 構造化データとして保存し、通知配信のソースになる。
///
/// 設計方針:
///   - **kind の判別ユニオン**: 'user' (個別) / 'all' / 'project_member' / 'role_*' / 'assignee'
///     - kind='user' のみ targetUserId を持つ (個別指定)
///     - その他 (グループメンション) は targetUserId=null、配信時に動的に展開
///   - **コメント削除で cascade 物理削除** (`onDelete: Cascade`):
///     - コメントが消えたメンションは意味を持たないため、データ整合性のため自動削除
///   - **編集時の差分処理**: 旧 mention と新 mention を kind+targetUserId で diff し、
///     **追加分のみ通知** を生成 (Q2 採用)。削除分は何もしない。
model Mention {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // PR #2: tenant 配属 (DEFAULT default-tenant)。親 Comment の tenantId と整合性をサービス層で担保。
  tenantId     String   @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  commentId    String   @map("comment_id") @db.Uuid
  kind         String   @db.VarChar(40)
  targetUserId String?  @map("target_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  comment    Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  targetUser User?   @relation("MentionTarget", fields: [targetUserId], references: [id])
  tenant     Tenant  @relation(fields: [tenantId], references: [id])

  @@index([commentId], map: "idx_mentions_comment")
  @@index([tenantId], map: "idx_mentions_tenant")
  @@map("mentions")
}

/// 通知 (PR feat/notifications-mvp): アプリ内のベル UI に表示するエンドユーザ向けメッセージ。
/// 設計方針:
///   - **アプリ内通知のみ** (メール / push 通知は対象外)
///   - **polymorphic 連携** (entity_type + entity_id) で将来コメント mention 等に拡張可能
///   - **dedupeKey** で同じトリガが 1 日 1 回しか発火しないよう保証 (例: 同タスクの開始通知が
///     同日に複数回作られない)
///   - 既読 (readAt が NULL でない) かつ 30 日経過したものは cron で物理削除
///   - 受信者 (userId) は単一。複数ユーザに同時通知する場合は service 層でループ生成する
///
/// MVP の type:
///   - 'task_start_due' : ACT の予定開始日当日 (status='not_started')
///   - 'task_end_due'   : ACT の予定終了日当日 (status≠'completed')
/// 将来:
///   - 'comment_mention': コメント本文の @username で言及
model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // PR #2: tenant 配属 (DEFAULT default-tenant)。User の tenantId と整合性をサービス層で担保。
  tenantId   String    @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String    @db.VarChar(40)
  entityType String    @map("entity_type") @db.VarChar(30)
  entityId   String    @map("entity_id") @db.Uuid
  title      String    @db.VarChar(200)
  link       String    @db.VarChar(500)
  /// 重複抑止用キー (例: `task_start_due:${taskId}:${YYYY-MM-DD}`)。
  /// UNIQUE 制約で 2 重生成を DB レベルで弾く (cron が時間内に 2 回呼ばれても安全)。
  dedupeKey  String    @map("dedupe_key") @db.VarChar(200)
  readAt     DateTime? @map("read_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user   User   @relation("NotificationRecipient", fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([dedupeKey], map: "idx_notifications_dedupe")
  @@index([userId, readAt, createdAt(sort: Desc)], map: "idx_notifications_user_unread")
  @@index([tenantId], map: "idx_notifications_tenant")
  @@map("notifications")
}

/// 個人メモ (PR #70): プロジェクトに紐付かない個人の知見・作業ノートを保存する。
/// visibility:
///   - 'private' (既定): 作成者本人のみ閲覧可、admin も含め他者不可視
///   - 'public' : 全ログインユーザが「全メモ」画面で閲覧可 (編集/削除は作成者のみ)
/// タグは持たせない (業務上の知見かどうかの判断は人間で行う方針、PR #70 要件より)。
/// 添付は PR #64 の attachments テーブルに entityType='memo' で紐付け可能。
model Memo {
  id               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // PR #2: tenant 配属 (DEFAULT default-tenant)。User の tenantId と整合性をサービス層で担保。
  tenantId         String                       @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @map("tenant_id") @db.Uuid
  userId           String                       @map("user_id") @db.Uuid
  title            String                       @db.VarChar(150)
  content          String                       @db.Text
  visibility       String                       @default("private") @db.VarChar(20)
  // PR #4 (T-03 Phase 2): title + content を結合した text の embedding
  contentEmbedding Unsupported("vector(1024)")? @map("content_embedding")
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?                    @map("deleted_at") @db.Timestamptz

  author User   @relation("MemoAuthor", fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  // 自分のメモ一覧 (MyMemos) での並び替えを効率化
  @@index([userId, createdAt(sort: Desc)], map: "idx_memos_user_recent")
  // 全メモ (公開メモ) 画面での並び替えを効率化
  @@index([visibility, createdAt(sort: Desc)], map: "idx_memos_visibility_recent")
  @@index([tenantId], map: "idx_memos_tenant")
  @@map("memos")
}

// ============================================================
// API Call Logs (PR #2 / T-03 提案エンジン v2)
// ============================================================
//
// 各 LLM / Embedding API 呼び出しの記録。**課金根拠データとして法的に重要**。
// withMeteredLLM ミドルウェアが成功時に必ず記録する。失敗時の記録方針は同 ミドルウェアに集約。
//
// `featureUnit` は「ユーザに見える 1 操作」と「内部処理」の対応関係を記録する識別子。
//   - 'new-project-suggestion'      新規プロジェクト作成時の提案 (1 回 = 1 操作)
//   - 'project-suggestion-refresh'  プロジェクト詳細での提案更新ボタン
//   - 'risk-creation-suggest'       リスク起票時のサジェスト
//   - 'auto-tag-extract'            プロジェクト保存時の自動タグ抽出 (Phase 1)
//   - 'embedding-backfill'          バックグラウンド一括 embedding 生成
//
// `costJpy` は当該呼び出しに「テナント側に発生した課金額」(Beginner: 0 = 無料、Expert: 10、Pro: 30)。
// 内部の Anthropic / Voyage AI API 実コストとは別概念で、本番運用では別系統の財務追跡で突合する。

model ApiCallLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  userId          String?  @map("user_id") @db.Uuid // cron / 匿名 / システム実行時は null
  featureUnit     String   @map("feature_unit") @db.VarChar(40)
  modelName       String   @map("model_name") @db.VarChar(60)
  /// LLM 入力トークン数 (Anthropic)。embedding 専用呼び出しは null。
  llmInputTokens  Int?     @map("llm_input_tokens")
  llmOutputTokens Int?     @map("llm_output_tokens")
  /// embedding トークン数 (Voyage AI)。LLM 専用呼び出しは null。
  embeddingTokens Int?     @map("embedding_tokens")
  /// テナント側に発生した課金額 (円整数)。
  costJpy         Int      @map("cost_jpy")
  latencyMs       Int      @map("latency_ms")
  requestId       String   @map("request_id") @db.VarChar(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation("ApiCallLogActor", fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)], map: "idx_api_call_logs_tenant")
  @@index([requestId], map: "idx_api_call_logs_request")
  @@index([featureUnit, createdAt(sort: Desc)], map: "idx_api_call_logs_feature")
  @@map("api_call_logs")
}

/// 提案候補の人間ライクな説明文キャッシュ (P-3 / 2026-05-08)
///
/// 役割:
///   提案画面で各候補 (knowledge / past_issue / retrospective) の「なぜこのプロジェクトに
///   関連するのか」を LLM (Pro=Sonnet / Beginner-Expert=Haiku) で生成した結果を
///   (projectId, candidateKind, candidateId) 単位で永続化する。
///   Lazy 生成 (ユーザがクリックした時だけ生成) + DB キャッシュで再課金を防ぐ。
///
/// 設計判断:
///   - **(projectId, candidateKind, candidateId) で unique**: 同じ提案画面を再訪 / 別ユーザが
///     同じ画面を開いても再課金しない。プロジェクトと候補のペアでキャッシュするため、
///     プロジェクト内容や候補内容が変わっても古い説明が再利用される
///     (= 軽い stale。許容)。本格的に invalidate したくなったら updatedAt 比較で
///     再生成判定するロジックを後付けする。
///   - **tenantId を直接持つ (denormalized)**: 認可境界の検証を join なしで実施可能。
///     Project にも tenantId はあるが、明示的にこのテーブルにも持つことで「外部から
///     渡された projectId が他テナントだった場合に弾く」サニタイズが容易。
///   - **modelName / costJpy を保存**: 過去の説明が Haiku 生成か Sonnet 生成かを後から
///     監視できるようにする (Pro プラン契約者の体験品質モニタ用)。
///   - **generatedBy (User FK)**: 監査用。説明生成は LLM 課金が発生するので、誰が
///     呼び出したかを残す。
///
/// 関連:
///   - サービス: src/services/suggestion-explanation.service.ts
///   - API: src/app/api/projects/[projectId]/suggestions/explain/route.ts
///   - 計画: docs/roadmap/V1_FINAL_TASKS.md P-3
model SuggestionExplanation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// 提案を受けたプロジェクト (= 「この PJ に対して説明する」の主語)
  projectId     String   @map("project_id") @db.Uuid
  /// 'knowledge' | 'issue' | 'retrospective'
  candidateKind String   @map("candidate_kind") @db.VarChar(20)
  /// 候補側の ID (Knowledge.id / RiskIssue.id / Retrospective.id)
  candidateId   String   @map("candidate_id") @db.Uuid
  /// 生成された説明文 (UI で表示)
  explanation   String   @db.Text
  /// 生成に使われた LLM モデル名 (例: 'claude-haiku-4-5' / 'claude-sonnet-4-6')
  modelName     String   @map("model_name") @db.VarChar(60)
  /// 生成時の課金額 (円整数)。同候補に対する重複課金は本テーブルの cache hit で防ぐ。
  costJpy       Int      @map("cost_jpy")
  /// 生成を実行したユーザ (監査用)
  generatedBy   String   @map("generated_by") @db.Uuid
  generatedAt   DateTime @default(now()) @map("generated_at") @db.Timestamptz

  tenant          Tenant  @relation(fields: [tenantId], references: [id])
  project         Project @relation(fields: [projectId], references: [id])
  generatedByUser User    @relation("SuggestionExplanationGeneratedBy", fields: [generatedBy], references: [id])

  /// 同じ (projectId, candidateKind, candidateId) は 1 つだけ。再要求時は cache hit。
  @@unique([projectId, candidateKind, candidateId], map: "uq_suggestion_explanation_target")
  @@index([tenantId, generatedAt(sort: Desc)], map: "idx_suggestion_explanations_tenant")
  @@map("suggestion_explanations")
}

/// テナント別月次使用量の履歴スナップショット (P-5b / 2026-05-08)
///
/// 役割:
///   月初リセット cron が `Tenant.currentMonthApiCallCount` / `currentMonthApiCostJpy` を
///   0 にリセット **する直前** の値を、yearMonth (= リセット対象月の 1 つ前の月) で
///   永続化する。super_admin の使用量履歴グラフ + CSV エクスポート + 請求書生成 (P-7)
///   の正本データになる。
///
/// 設計判断:
///   - **(tenantId, yearMonth) で unique**: 月次リセット cron の冪等性 (= 二重実行で
///     行が重複しない) を保証。仮に cron が同月に複数回起動されても、最初の 1 回で
///     決まったスナップショットを保つ。
///   - **yearMonth は varchar(7) "YYYY-MM"**: 月単位の集計しか必要ないので date 型ではなく
///     人間可読な文字列で持つ。SQL での SUBSTR 等不要、ORDER BY も自然に降順可能。
///   - **plan / activeUserCount も保存**: 月次の課金根拠を後から再現可能にする
///     (= 「2026-04 月時点で Pro プラン × アクティブ 5 人で ¥9,000」が後から監査できる)。
///   - **管理テナント (Knowledge Relay Platform) は保存しない**:
///     呼出側 (snapshot サービス) で `id != MANAGEMENT_TENANT_ID` で絞る。集計画面でも
///     同様に除外しているため整合する。
///
/// 関連:
///   - cron: src/services/tenant-monthly-reset.service.ts
///   - 集計サービス: src/services/super-admin.service.ts (listMonthlyUsageHistory)
///   - CSV API: src/app/api/admin/super/usage/export/route.ts
///   - UI: src/app/(dashboard)/admin/super/usage/page.tsx
///   - 計画: docs/roadmap/V1_FINAL_TASKS.md P-5
model TenantMonthlyUsageHistory {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  /// "YYYY-MM" 形式 (例: "2026-04" = 2026 年 4 月分)
  yearMonth        String   @map("year_month") @db.VarChar(7)
  /// 当月総コール数 (= リセット直前の Tenant.currentMonthApiCallCount)
  apiCallCount     Int      @map("api_call_count")
  /// 当月総課金額 (= リセット直前の Tenant.currentMonthApiCostJpy、円整数)
  apiCostJpy       Int      @map("api_cost_jpy")
  /// 当月末時点のプラン (請求書根拠用)
  plan             String   @db.VarChar(20)
  /// 当月末時点のアクティブユーザ数 (請求書根拠用)
  activeUserCount  Int      @map("active_user_count")
  /// 後続 PR (Storage add-on) で使用予定のフィールド (前方互換のため Phase 1 で追加)。
  ///   Phase 1 (外部 import) では値は 0 / 'standard' のまま記録される。
  ///   Phase 2 (Storage add-on 実装) で実値を投入し super_admin ダッシュボードで表示する。
  storageBytesUsed BigInt   @default(0) @map("storage_bytes_used")
  storageAddonPlan String   @default("standard") @map("storage_addon_plan") @db.VarChar(20)
  storageAddonJpy  Int      @default(0) @map("storage_addon_jpy")
  /// 当月総課金額 (LLM + Storage の合算)。super_admin ダッシュボードでの集計に使う。
  totalJpy         Int      @default(0) @map("total_jpy")
  /// snapshot 生成日時 (= 月初リセット cron の起動時刻)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  /// (tenantId, yearMonth) は 1 件のみ。月次 cron の冪等性保証。
  @@unique([tenantId, yearMonth], map: "uq_tenant_monthly_usage_history")
  @@index([yearMonth], map: "idx_monthly_usage_year_month")
  @@map("tenant_monthly_usage_history")
}

/// テナント外部データ移行 (Phase 1 / 2026-05-08): preview 結果の一時保存。
///
/// 役割:
///   POST /api/tenants/me/external-import/preview で検証済データを TTL 24 時間で保存し、
///   ユーザが内容確認 → POST .../apply で確定する 2 段階フローを成立させる。
///
/// 設計判断:
///   - **24 時間 TTL**: 翌営業日の上司承認等を見越して 1 時間→24 時間に拡大 (2026-05-08 ユーザ確定)。
///   - **parsedJson に検証済データを格納**: apply 時にパース/バリデーションを再実行不要にする。
///   - **costEstimate も併存**: apply 時に当時の見積と現在の状態を比較して二重防御。
///   - **expiresAt インデックス**: 期限切れ削除 cron が高速に対象抽出できるようにする。
///   - **tenantId 直接持つ**: 認可境界 (= 他テナントの previewId を盗用しても弾く) の前提。
///
/// 関連:
///   - サービス: src/services/external-data-import.service.ts
///   - cron: tenant-monthly-reset と同 endpoint で expiresAt < NOW() を削除
model TenantImportPreview {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  /// preview を生成した admin user (= apply 時に同一ユーザのみ実行可、別管理者の preview は使えない)
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  /// パース + バリデーション済の取込予定データ (knowledge[], risksIssues[])。
  /// Phase 1 では Knowledge と RiskIssue のみ含まれる。
  parsedJson      Json     @map("parsed_json") @db.JsonB
  /// 課金見積 (calls / estimatedJpy / projectedMonthJpy 等)。apply 時に状況再評価する。
  costEstimate    Json     @map("cost_estimate") @db.JsonB
  /// パース済件数 / エラー件数 / エラー詳細のサマリ (UI 再表示や監査用)
  summary         Json     @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// 24 時間後 (= createdAt + 24h)、cron がこれより前のレコードを削除する
  expiresAt       DateTime @map("expires_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation("TenantImportPreviewCreator", fields: [createdByUserId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)], map: "idx_tenant_import_preview_tenant")
  @@index([expiresAt], map: "idx_tenant_import_preview_expires")
  @@map("tenant_import_preview")
}

/// メール送信ログ (P-H / 2026-05-08)
///
/// 役割:
///   getMailProvider().send() の全送信を 1 行 1 record で記録する。
///   super_admin ダッシュボードで「日次 / 月次の送信件数 + 上限到達警告」を表示する元データ。
///   Brevo 無料 300 通/日 等の vendor 上限超過事故を未然に検知する目的。
///
/// 設計判断:
///   - **本文・件名は保存しない**: PII / 機密情報の漏洩防止 (= recipient hash + 種別のみ)
///   - **recipient ハッシュ化**: SHA-256 で保存 (= 「同じ宛先に送ったか」を確認できる程度の情報量)
///   - **type フィールド**: 'invitation' / 'usage_alert' / 'beginner_warning_60' /
///     'beginner_warning_75' / 'beginner_expired' / その他 — 送信目的別の集計用
///   - **success / error**: provider が返した結果。失敗ログも残し、自動 retry 判断材料に
///   - **tenantId は optional**: cron 経由 (= 特定テナント外) の system 通知も記録対象のため
///
/// 関連:
///   - 計画: docs/roadmap/V1_FINAL_TASKS.md P-H
///   - 集計サービス: src/services/email-send-log.service.ts
///   - UI: super_admin ダッシュボード (P-5a と同パターンのカード)
model EmailSendLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 関連テナント (cron 経由で特定テナント外の通知は null = システム通知)
  tenantId        String?  @map("tenant_id") @db.Uuid
  /// 送信種別 ('invitation' / 'usage_alert' / 'beginner_warning_60' / etc.)
  type            String   @db.VarChar(40)
  /// 送信先メールアドレスの SHA-256 ハッシュ (PII 漏洩防止)
  recipientHash   String   @map("recipient_hash") @db.VarChar(64)
  /// 送信先メールアドレスのドメイン部のみ保存 (= '@example.com' / 集計時のドメイン分布把握用)
  recipientDomain String   @map("recipient_domain") @db.VarChar(255)
  /// 送信成功したか (provider.send の戻り値ベース)
  success         Boolean
  /// 失敗時のエラーメッセージ (= provider 側のエラー応答)
  errorMessage    String?  @map("error_message") @db.Text
  /// プロバイダ名 ('brevo' / 'resend' / 'console' / 'inbox' / 'smtp')
  providerName    String   @map("provider_name") @db.VarChar(20)
  sentAt          DateTime @default(now()) @map("sent_at") @db.Timestamptz

  @@index([sentAt(sort: Desc)], map: "idx_email_send_logs_sent_at")
  @@index([type, sentAt(sort: Desc)], map: "idx_email_send_logs_type")
  @@map("email_send_logs")
}

// ============================================================
// Stripe Metered Billing 連携 (PR-S1 / 2026-05-14)
// 関連:
//   - 仕様: docs/business/STRIPE_BILLING.md
//   - 詳細技術設計: docs/design/STRIPE_TECHNICAL_DESIGN.md
//   - 設計判断: docs/adr/0006-stripe-metered-billing-integration.md
//   - 実装計画: docs/roadmap/STRIPE_INTEGRATION_PLAN.md
// ============================================================

/// Stripe Webhook の冪等性保証 + 再送 / リプレイ対応のための受信イベント記録。
///
/// - Stripe は同じイベントを複数回送信する可能性がある (= 公式仕様、`At least once` 配信)
/// - 受信時に id (= Stripe event.id) で UNIQUE INSERT、既存なら処理スキップ
/// - processedAt で「処理済」を判定、失敗時は retryCount を増やして 5 分間隔 cron で再試行
/// - 3 回失敗で DLQ 入り (= nextRetryAt=null)、super_admin 画面 /admin/super/stripe/dlq で手動再試行
///
/// 関連: STRIPE_TECHNICAL_DESIGN.md §B-2
model StripeWebhookEvent {
  /// = Stripe event.id (例: "evt_xxxxxxxxxxxxxx")。冪等性キー
  id           String    @id @db.VarChar(50)
  /// イベント種別 (例: "customer.subscription.updated", "invoice.payment_failed")
  type         String    @db.VarChar(60)
  /// 受信した payload 全体 (= JSON)。失敗時の調査・リプレイ用
  payloadJson  Json      @map("payload_json")
  /// Stripe からの受信時刻
  receivedAt   DateTime  @default(now()) @map("received_at") @db.Timestamptz
  /// 処理完了時刻。null = 未処理 / Date = 処理完了
  processedAt  DateTime? @map("processed_at") @db.Timestamptz
  /// 処理失敗時のエラーメッセージ (運用調査用)
  errorMessage String?   @map("error_message") @db.Text
  /// 失敗試行回数 (0=初回失敗前 / 1=1回失敗 / ... / 3=DLQ入り)
  retryCount   Int       @default(0) @map("retry_count")
  /// 次回再試行スケジュール時刻 (null = DLQ 入り、再試行停止)
  nextRetryAt  DateTime? @map("next_retry_at") @db.Timestamptz

  // Indexes:
  //   1. type で「特定イベント種別の履歴」を抽出
  //   2. processedAt が null かつ nextRetryAt が今より前 = 再試行候補
  //   3. processedAt が null かつ retryCount >= 3 = DLQ
  @@index([type], map: "idx_stripe_webhook_events_type")
  @@index([processedAt, nextRetryAt], map: "idx_stripe_webhook_events_retry_candidates")
  @@map("stripe_webhook_events")
}

/// 請求履歴。invoice / bank_transfer / credit_card の **全支払い方法を統一管理**。
///
/// - `invoice` / `bank_transfer`: super_admin が手動で status='paid' に更新
/// - `credit_card`: Stripe Webhook (invoice.created / invoice.paid / invoice.payment_failed) で自動更新
/// - 月途中で invoice → credit_card 切替時、切替前のレコードは status='replaced_by_stripe' に
///   更新して Stripe 一括請求に切替 (= 詳細技術設計 §C-1)
///
/// 既存 `tenant_monthly_usage_history` (使用量スナップショット) との違い:
/// こちらは「請求書 / 決済」のライフサイクル管理、月次集計の確定値ではなく支払い状況の追跡。
///
/// 関連: STRIPE_TECHNICAL_DESIGN.md §C-1 / STRIPE_BILLING.md §2.3
model BillingHistory {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  /// "YYYY-MM" 形式の請求対象月 (= テナント TZ ベースの月単位)
  yearMonth          String    @map("year_month") @db.VarChar(7)
  /// 支払い方法 ('invoice' = 銀行振込（請求書送付） / 'credit_card' = 自動引落)。
  /// 旧 'bank_transfer' 値は廃止し 'invoice' に統合済 (UI ラベルは「銀行振込」)。
  paymentMethod      String    @map("payment_method") @db.VarChar(20)
  /// 課金額 (税抜、円整数)
  amountJpy          Int       @map("amount_jpy")
  /// 消費税額 (円整数)。Stripe Tax 計算結果を保存
  taxAmountJpy       Int       @map("tax_amount_jpy")
  /// 税込み合計 (= amount_jpy + tax_amount_jpy)
  totalAmountJpy     Int       @map("total_amount_jpy")
  /// 状態:
  ///   'pending'             = 請求書発行待ち or Stripe Invoice 確定待ち
  ///   'paid'                = 入金確認済 (invoice は手動消込、credit_card は Webhook 自動)
  ///   'failed'              = 引落失敗 (credit_card のみ、Smart Retries 中)
  ///   'refunded'            = 返金済
  ///   'canceled'            = 請求取消 (= 顧客側の合意のもと)
  ///   'replaced_by_stripe'  = 月途中で invoice → credit_card 切替時、invoice 側を Stripe 一括に置換
  status             String    @map("status") @db.VarChar(20)
  /// Stripe Invoice ID (credit_card 払いのみ)
  stripeInvoiceId    String?   @map("stripe_invoice_id") @db.VarChar(50)
  /// 入金確認日時 (status='paid' 時)
  paidAt             DateTime? @map("paid_at") @db.Timestamptz
  /// 失敗理由 (= Stripe failure_code 等を保存)
  failureReason      String?   @map("failure_reason") @db.VarChar(50)
  /// Smart Retries の試行回数 (credit_card のみ、0〜4)
  retryCount         Int       @default(0) @map("retry_count")
  /// PR-V7a (2026-05-19): 銀行振込の支払期日 (= 翌月 25 日 JST 23:59:59)。
  ///   credit_card の場合は null (= Stripe Smart Retries が管理)。
  ///   src/config/billing.ts calculateInvoiceDueDate() で算出して保存。
  paymentDueDate     DateTime? @map("payment_due_date") @db.Timestamptz
  /// PR-V7a (2026-05-19): 期日超過 alert を super_admin に最後に送信した日時。
  ///   毎日 cron で「dueDate + OVERDUE_ALERT_THRESHOLD_DAYS 超過 AND status='pending'」を検知、
  ///   このフィールドが 24h 以内ならスキップ (= dedup)。
  overdueAlertSentAt DateTime? @map("overdue_alert_sent_at") @db.Timestamptz
  /// PR-V7a (2026-05-19): credit_card Smart Retries の次回試行予定時刻。
  ///   invoice.payment_failed Webhook の invoice.next_payment_attempt をそのまま保存。
  ///   super_admin の billing 詳細画面で「次回リトライ: YYYY-MM-DD」を表示。
  nextPaymentAttempt DateTime? @map("next_payment_attempt") @db.Timestamptz
  /// PR-V7a (2026-05-19): 銀行振込の手動消込実行者 User ID (= AuditLog にも記録、こちらは参照用)。
  ///   credit_card の場合は null (= Webhook 自動更新)。
  confirmedBy        String?   @map("confirmed_by") @db.Uuid
  /// PR-V7a (2026-05-19): 手動消込実行時刻 (paidAt とは区別。paidAt は status=paid 移行時刻全般、
  ///   confirmedAt は super_admin の操作時刻のみ)。
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  /// (tenantId, yearMonth) は 1 件のみ。切替月は status='replaced_by_stripe' で
  /// 既存レコードを更新 (= 物理削除せず監査用に残す)、新規レコードを追加しない設計
  @@unique([tenantId, yearMonth], map: "uq_billing_history_tenant_month")
  @@index([status], map: "idx_billing_history_status")
  @@index([stripeInvoiceId], map: "idx_billing_history_stripe_invoice")
  /// PR-V7a: 期日超過検知 cron 用 (= status='pending' AND payment_due_date < now)
  @@index([paymentDueDate, status], map: "idx_billing_history_due_date")
  @@map("billing_history")
}

/// Stripe Usage Record 送信 queue。
///
/// `withMeteredLLM` で API 呼び出しのたびに INSERT し、5 分間隔の cron で順次 Stripe へ送信。
///
/// - 同期送信を避ける理由: Stripe API 障害時に LLM 呼び出しが止まる事を防ぐ
/// - 冪等性: apiCallLogId を idempotency_key として Stripe に送信 → 同じ ApiCallLog から
///   2 回送られても Stripe 側で 1 回扱い
/// - 月途中切替時の backfill: 切替前 ApiCallLog をこのテーブルに一括 INSERT して遡及送信
///
/// 関連: STRIPE_TECHNICAL_DESIGN.md §B-3 / §C-1 / §D-1
model StripeUsageRecordQueue {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  /// 'haiku' / 'sonnet' = Subscription Item の識別 (= tenant の subscriptionItemId を解決)
  callType     String    @map("call_type") @db.VarChar(20)
  /// 元の ApiCallLog.id (= idempotency_key として使用)
  apiCallLogId String    @map("api_call_log_id") @db.Uuid
  quantity     Int       @default(1)
  /// 元の API 呼び出し時刻 (= Stripe Usage Record の timestamp として送信)
  occurredAt   DateTime  @map("occurred_at") @db.Timestamptz
  /// 送信試行回数 (0〜5)
  retryCount   Int       @default(0) @map("retry_count")
  /// 次回送信予定時刻 (null = もう送らない = DLQ 入り)
  ///   exponential backoff: 1, 5, 15, 60, 240 分
  nextSendAt   DateTime? @map("next_send_at") @db.Timestamptz
  /// 送信成功時刻 (null = 未送信、Date = 完了)
  sentAt       DateTime? @map("sent_at") @db.Timestamptz
  /// 直近のエラーメッセージ
  lastError    String?   @map("last_error") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // Indexes:
  //   1. 送信候補抽出: sentAt が null かつ nextSendAt が今より前
  //   2. テナント別の状況確認用
  @@index([sentAt, nextSendAt], map: "idx_stripe_usage_queue_pending")
  @@index([tenantId], map: "idx_stripe_usage_queue_tenant")
  @@map("stripe_usage_record_queue")
}

/// テナント作成時の利用規約・プライバシーポリシーへの同意ログ
///
/// 法的根拠 (民法 548 条の 2 / 定型約款の組入合意) のため、サインアップ時に
/// 利用規約・プライバシーポリシーへの同意を取得し、本テーブルに不可変ログとして
/// 残す。後日「同意していない」と争われた際の証跡となる。
///
/// 設計:
///   - tenantId + consentType + version の組合せで一意化 (再同意の重複防止)
///   - acceptedAt は immutable (UPDATE 禁止、論理削除のみ可)
///   - 規約・プラポリは外部 LP (HomePage / tasukiba-user.md) に集約しているため、
///     version は LP 側で管理 (本テーブルでは「いつ・どのバージョンに同意したか」を記録)
///
/// feat/legal-pages-lp-integration (2026-05-21)
model TenantConsentLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// 同意したユーザの ID (sign up 時の初期 admin)。User は作成と同時に作られるため tenant 作成後に確定。
  /// 直接の FK は張らず String 保持 (User の物理削除と独立に証跡を保つ)。
  userId      String   @map("user_id") @db.Uuid
  /// 'terms' | 'privacy'
  consentType String   @map("consent_type") @db.VarChar(20)
  /// 同意した規約・プラポリのバージョン (例: '1.0')。LP 側の version 表記と一致。
  version     String   @db.VarChar(20)
  /// 同意取得時の IP アドレス (証跡)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  /// 同意取得時の User-Agent (証跡)
  userAgent   String?  @map("user_agent") @db.Text
  acceptedAt  DateTime @default(now()) @map("accepted_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // 同一テナント・同一タイプ・同一バージョンの重複同意を防止 (= 1 回サインアップ = 各 type 1 行)
  @@unique([tenantId, consentType, version])
  @@index([tenantId], map: "idx_tenant_consent_logs_tenant")
  @@map("tenant_consent_logs")
}

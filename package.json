{
  "name": "tasukiba",
  "version": "1.5.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "build:netlify": "prisma generate && prisma migrate deploy && next build && (tsx scripts/generate-faq-embeddings.ts || echo '[WARN] post-build FAQ embedding sync skipped or failed - run `pnpm generate:faq-embeddings` manually (詳細: docs/operations/DEPLOYMENT.md §4.4)')",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\"",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:suggestion": "tsx prisma/seed-suggestion.ts",
    "db:clean:suggestion": "tsx scripts/clean-management-seed.ts",
    "seed:generate-embeddings": "tsx scripts/generate-seed-embeddings.ts",
    "generate:faq-embeddings": "tsx scripts/generate-faq-embeddings.ts",
    "check:faq-embeddings-sync": "tsx scripts/check-faq-embeddings-sync.ts",
    "db:reset": "prisma migrate reset",
    "db:deploy": "prisma migrate deploy",
    "db:recover": "tsx scripts/recover-prisma-migrations.ts",
    "migrate:print": "tsx scripts/print-migration.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "e2e:coverage-check": "tsx scripts/check-e2e-coverage.ts",
    "verify:storage-coverage": "tsx scripts/verify-tenant-storage-coverage.ts",
    "security:check": "tsx scripts/security-check.ts",
    "security:gate": "tsx scripts/security-check.ts --min-score=90",
    "check:banned-auth-patterns": "tsx scripts/check-banned-auth-patterns.ts",
    "check:llm-billing-bypass": "tsx scripts/check-llm-billing-bypass.ts",
    "check:no-hardcoded-jp": "tsx scripts/check-no-hardcoded-jp.ts --baseline scripts/i18n-baseline.json",
    "check:no-hardcoded-jp:report": "tsx scripts/check-no-hardcoded-jp.ts --report",
    "check:no-hardcoded-jp:update-baseline": "tsx scripts/check-no-hardcoded-jp.ts --update-baseline scripts/i18n-baseline.json",
    "check:no-hardcoded-jp:strict": "tsx scripts/check-no-hardcoded-jp.ts --strict",
    "check:banned-i18n-patterns": "tsx scripts/check-banned-i18n-patterns.ts --baseline scripts/i18n-banned-patterns-baseline.json",
    "check:banned-i18n-patterns:report": "tsx scripts/check-banned-i18n-patterns.ts --report",
    "check:banned-i18n-patterns:update-baseline": "tsx scripts/check-banned-i18n-patterns.ts --update-baseline scripts/i18n-banned-patterns-baseline.json",
    "check:banned-i18n-patterns:strict": "tsx scripts/check-banned-i18n-patterns.ts --strict",
    "check:migration-sync": "bash scripts/check-migration-sync.sh",
    "perf:check": "tsx scripts/check-perf-antipatterns.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@base-ui/react": "^1.6.0",
    "@holiday-jp/holiday_jp": "^2.5.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.108.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.8.0",
    "next": "16.2.11",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.13.2",
    "otplib": "^13.4.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.4",
    "prisma": "^7.8.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^6",
    "vite": "8.0.16",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines",
      "esbuild"
    ],
    "overrides": {
      "@hono/node-server": ">=1.19.13",
      "hono": ">=4.12.25",
      "postcss": ">=8.5.10",
      "ip-address": ">=10.1.1",
      "fast-uri": ">=3.1.2",
      "qs": ">=6.15.2",
      "uuid": ">=11.1.1",
      "tmp": ">=0.2.7",
      "esbuild": ">=0.28.1",
      "js-yaml": ">=4.2.0"
    }
  }
}

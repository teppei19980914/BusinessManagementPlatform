{
  "name": "tasukiba",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx}\"",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:suggestion": "tsx prisma/seed-suggestion.ts",
    "seed:generate-embeddings": "tsx scripts/generate-seed-embeddings.ts",
    "db:reset": "prisma migrate reset",
    "db:deploy": "prisma migrate deploy",
    "db:recover": "tsx scripts/recover-prisma-migrations.ts",
    "migrate:print": "tsx scripts/print-migration.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "e2e:coverage-check": "tsx scripts/check-e2e-coverage.ts",
    "security:check": "tsx scripts/security-check.ts",
    "security:gate": "tsx scripts/security-check.ts --min-score=90"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@base-ui/react": "^1.4.0",
    "@holiday-jp/holiday_jp": "^2.5.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^6.2.1",
    "diff": "^9.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.11.1",
    "otplib": "^13.4.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines",
      "esbuild"
    ],
    "overrides": {
      "@hono/node-server": ">=1.19.13",
      "hono": ">=4.12.16",
      "postcss": ">=8.5.10",
      "ip-address": ">=10.1.1",
      "fast-uri": ">=3.1.2"
    }
  }
}
